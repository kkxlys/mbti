# 微信支付 API v3 配置
# 真实密钥请放到 .env.local，不要提交到仓库。

# 公众号/服务号 AppID。JSAPI 支付需要已认证服务号/公众号，并和商户号完成绑定。
WECHAT_PAY_APPID=wx634eed8e020b866f

# 微信支付商户号
WECHAT_PAY_MCHID=1745810998

# API v3 密钥，商户平台 -> 账户中心 -> API 安全中设置，32 位。
WECHAT_PAY_API_V3_KEY=

# 商户 API 证书序列号
WECHAT_PAY_MERCHANT_SERIAL_NO=6ACA5FC56D83AF9E9CF776C931713230B5C25527

# 商户 API 私钥。二选一：直接填 PEM，或填下面的 WECHAT_PAY_PRIVATE_KEY_PATH。
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem

# 域名配置：
# 1. 微信支付商户平台 -> 产品中心 -> 开发配置 -> JSAPI 支付授权目录：https://soul-major.cn/
# 2. 微信公众平台 -> 公众号设置 -> 功能设置 -> 网页授权域名：soul-major.cn
# 3. 支付成功通知地址必须是公网 HTTPS，且不能带查询参数。
WECHAT_PAY_NOTIFY_URL=https://soul-major.cn/api/pay/wechat/notify

# 报告价格，单位：分。
WECHAT_PAY_REPORT_PRICE_CENTS=990

# 推荐：微信支付公钥，用于验证微信支付应答和回调。
# 商户平台 -> 账户中心 -> API 安全 -> 微信支付公钥。
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_0000000000
WECHAT_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_PAY_PUBLIC_KEY_PATH=/app/certs/pub_key.pem

# 可选：如果仍使用平台证书模式，可填 JSON，key 为 Wechatpay-Serial，value 为证书 PEM。
# WECHAT_PAY_VERIFY_KEYS_JSON={"SERIAL_NO":"-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"}

# 后台管理面板
# 生成命令：npm run admin:hash -- "换成至少12位的强密码"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# 仅本地 http 调试时可设为 false；线上不要关闭 Secure Cookie。
# ADMIN_COOKIE_SECURE=false
