# Docker 线上环境变量模板。
# 复制为 .env.production 后再填真实值；不要把 .env.production 提交到仓库。

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# 已知业务配置，我已替你填好。
WECHAT_PAY_NOTIFY_URL=https://soul-major.cn/api/pay/wechat/notify
WECHAT_PAY_REPORT_PRICE_CENTS=990
WECHAT_SITE_URL=https://soul-major.cn
ADMIN_SITE_URL=https://soul-major.cn
ADMIN_COOKIE_SECURE=true

# 后台管理：必须你自己填。
# 生成密码哈希：npm run admin:hash -- "换成至少12位的强密码"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# 微信支付：你说先暂时不配置，所以这里留空；应用可以正常启动。
WECHAT_PAY_APPID=wx634eed8e020b866f
WECHAT_MP_APPID=wx634eed8e020b866f
WECHAT_MP_APP_SECRET=
WECHAT_OAUTH_SESSION_SECRET=
WECHAT_PAY_MCHID=1745810998
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=6ACA5FC56D83AF9E9CF776C931713230B5C25527
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_PATH=/app/certs/pub_key.pem
# WECHAT_PAY_VERIFY_KEYS_JSON=
